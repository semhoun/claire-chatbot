{% if brain_info.css %}
<link rel="stylesheet" href="{{ base_url }}/css/{{ brain_info.css }}">
{% endif %}
{% if brain_info.css_inline %}
<style>{{ brain_info.css_inline|raw }}</style>
{% endif %}

<div class="claire-embed-wrapper" data-accepted-ext="{{ settings.get('files.upload.acceptedExt') }}">
    <div class="claire-embed is-collapsed">
        {% include 'partials/embed_toolbar.twig' %}
        <section class="claire-chat-panel">
            <div class="claire-chat-shell">
                {% include 'partials/chat_body.twig' %}
            </div>
        </section>
    </div>
</div>

{% include 'partials/modal_dialog.twig' %}
