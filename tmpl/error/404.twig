{% extends 'layout_base.twig' %}

{% block style %}
<style>
    .claire-error-panel {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        background: rgba(0,0,0,0.45);
        color: #fff;
        padding: 40px;
        border-radius: 16px;
        max-width: 90%;
    }
    .claire-error-title {
        font-size: clamp(48px, 12vw, 120px);
        line-height: 1;
        font-weight: 800;
        margin: 0 0 12px;
        color: #fff;
        text-shadow: 0 2px 16px rgba(0,0,0,0.4);
    }
    .claire-error-subtitle {
        font-size: clamp(16px, 3.5vw, 22px);
        margin: 0 0 24px;
        color: rgba(255,255,255,0.9);
    }
    .claire-error-btn {
        display: inline-block;
        padding: 12px 24px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        background: #0d6efd;
        color: #fff;
        box-shadow: 0 6px 18px rgba(13,110,253,0.35);
        transition: transform .06s ease, box-shadow .2s ease, background-color .2s ease;
    }
    .claire-error-btn:hover {
        background: #0b5ed7;
        transform: translateY(-1px);
        box-shadow: 0 10px 24px rgba(13,110,253,0.45);
    }
</style>
{% endblock %}

{% block content %}
    <div class="claire-error-panel">
        <h1 class="claire-error-title">404</h1>
        <p class="claire-error-subtitle">Oups ! La page que vous recherchez est introuvable.</p>
        <a href="/" class="claire-error-btn">Retour à l'accueil</a>
    </div>
{% endblock %}
