<!-- index.html -->
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Claire</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#ff3cac">
    <link rel="icon" href="{{ base_url }}/image/icon-192.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ base_url }}/css/style.css">
    {% if brain_info.css %}
    <link rel="stylesheet" href="{{ base_url }}/css/{{ brain_info.css }}">
    {% endif %}
    {% if brain_info.css_inline %}
    <style>{{ brain_info.css_inline|raw }}</style>
    {% endif %}

    <link rel="stylesheet" href="{{ base_url }}/css/highlight.min.css">
    <script src="{{ base_url }}/js/highlight.min.js"></script>
</head>
<body class="{{ (layout_mode|default('full')) == 'compact' ? 'claire-compact' : '' }}" data-base-url="{{ base_url }}" data-accepted-ext="{{ settings.get('files.upload.acceptedExt') }}">
<div class="claire-app">
    {% block app %}{% endblock %}

    <!-- Backdrop pour le panneau d'options (fermeture au clic en dehors) -->
    <div class="claire-options-backdrop" id="claire-options-backdrop" aria-hidden="true"></div>

    <aside class="claire-options-panel" id="claire-options-panel">
        <button
                class="claire-options-close"
                type="button"
                aria-label="Fermer le panneau d’options"
                title="Fermer"
        >
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
        </button>
        <div class="claire-options-panel__section">
            <span class="claire-options-panel__title">Conversations</span>
            <div
                class="claire-options-item"
                role="button"
                tabindex="0"
                hx-post="{{ base_url }}/history/new"
                hx-swap="none"
                hx-indicator="#claire-global-action-indicator"
                hx-on:keydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); this.click(); }"
                hx-vals="js:{sessionId: window.claireStreamSessionId || ''}"
                hx-on::after-request="
                     if (event.detail.successful) {
                         try {
                             const payload = JSON.parse(event.detail.xhr.responseText || '{}');
                             if (payload.threadId && window.claireUpdatePersistentChatStream) {
                                 window.claireUpdatePersistentChatStream(payload.threadId);
                             }
                         } catch (e) {}
                         // Ferme le panneau d'options
                         const panel = document.getElementById('claire-options-panel');
                        const bd = document.getElementById('claire-options-backdrop');
                         const toggle = document.querySelector('.claire-options-toggle');
                         if (panel) panel.classList.remove('claire-is-open');
                         if (bd) bd.classList.remove('claire-is-visible');
                         if (toggle) toggle.classList.remove('claire-is-active');

                        // Scroll en bas
                        const chatBody = document.querySelector('.claire-chat-body');
                        if (chatBody) chatBody.scrollTop = chatBody.scrollHeight;

                        // Rafraîchir le compteur
                        const countUrl = '{{ base_url }}/history/count';
                        if (window.htmx) { htmx.ajax('GET', countUrl, {target: '#claire-history-count-badge', swap: 'innerHTML'}); }
                    }
                "
            >
                <span class="claire-options-item__label">Nouvelle conversation</span>
            </div>
            <div class="claire-options-list">
                <div
                        class="claire-options-item"
                        id="claire-history-toggle"
                        role="button"
                        tabindex="0"
                        aria-expanded="false"
                        aria-controls="claire-history-list"
                >
                    <span class="claire-options-item__label">Historique des conversations</span>
                    <span
                            class="claire-options-item__badge"
                            id="claire-history-count-badge"
                            hx-get="{{ base_url }}/history/count"
                            hx-swap="innerHTML"
                    >0</span>
                </div>
                <div id="claire-history-list" class="claire-options-subpanel" aria-live="polite" style="margin: 0 16px 8px;"></div>
            </div>
        </div>

        <div class="claire-options-panel__section">
            <span class="claire-options-panel__title">Données</span>
            <div class="claire-options-list">
                <div
                        class="claire-options-item"
                        id="claire-files-toggle"
                        role="button"
                        tabindex="0"
                        aria-expanded="false"
                        aria-controls="claire-files-list"
                >
                    <span class="claire-options-item__label">Fichiers</span>
                    <span
                            class="claire-options-item__badge"
                            id="claire-files-count-badge"
                            hx-get="{{ base_url }}/files/count"
                            hx-swap="innerHTML"
                    >0</span>
                </div>
                <div id="claire-files-list" class="claire-options-subpanel claire-files-root" aria-live="polite" style="margin: 0 16px 8px;"></div>
            </div>

            <div class="claire-options-list">
                <div
                        class="claire-options-item"
                        id="claire-rag-toggle"
                        role="button"
                        tabindex="0"
                        aria-expanded="false"
                        aria-controls="claire-rag-panel"
                        data-open-upload-dialog
                        data-upload-context="rag"
                >
                    <span class="claire-options-item__label">Documents RAG</span>
                </div>
            </div>
        </div>

        <div class="claire-options-panel__section">
            <span class="claire-options-panel__title">Préférences</span>
            <div class="claire-options-list">
                <div class="claire-options-item">
                    <label for="claire-brain-selector" class="claire-options-item__label claire-brain-selector" style="cursor: pointer;">Assistant</label>
                    <span class="claire-options-item__badge claire-brain-selector">
                        <select id="claire-brain-selector" name="brain">
                            {% for b in brains|default([]) %}
                                <option value="{{ b.slug }}" {{ (current_brain|default('claire')) == b.slug ? 'selected' : '' }}>
                                    {{ b.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </span>
                </div>
                {% if comfyui_enabled and comfyui_workflows is not empty %}
                    <div class="claire-options-item">
                        <label for="claire-comfyui-workflow-selector" class="claire-options-item__label" style="cursor: pointer;">Workflow ComfyUI</label>
                        <span class="claire-options-item__badge claire-brain-selector">
                            <select id="claire-comfyui-workflow-selector" name="comfyui_workflow">
                                {% for workflow in comfyui_workflows %}
                                    <option value="{{ workflow.slug }}" {{ current_comfyui_workflow == workflow.slug ? 'selected' : '' }}>
                                        {{ workflow.label }}
                                    </option>
                                {% endfor %}
                            </select>
                        </span>
                    </div>
                {% endif %}
                <div
                        class="claire-options-item"
                        id="claire-toggle-layout-mode"
                        data-layout-toggle
                        data-layout-mode="{{ layout_mode|default('full') }}"
                >
                    <span class="claire-options-item__label">Mode largeur</span>
                    <span class="claire-options-item__badge" data-layout-badge>
                        {{ (layout_mode|default('full')) == 'compact' ? 'Largeur 800px' : 'Plein écran' }}
                    </span>
                </div>
            </div>
        </div>

        {% if (uinfo is defined) and (uinfo.id != 'default') %}
            <div class="claire-options-panel__section">
                <span class="claire-options-panel__title">Compte</span>
                <div class="claire-options-list">
                    <div class="claire-options-item" aria-current="true">
                        <span class="claire-options-item__label">{{ uinfo.displayName }}</span>
                    </div>
                    <div
                        class="claire-options-item"
                        role="button"
                        tabindex="0"
                        hx-get="{{ base_url }}/config/telegram_form"
                        hx-target="#claire-modal-body"
                        hx-swap="innerHTML"
                        hx-on::after-request="
                            document.getElementById('claire-modal-title').textContent = 'Configuration Telegram';
                            const confirmBtn = document.getElementById('claire-modal-confirm');
                            const cancelBtn = document.getElementById('claire-modal-cancel');
                            confirmBtn.textContent = 'Enregistrer';
                            const form = document.getElementById('claire-telegram-config-form');
                            confirmBtn.disabled = false;
                            confirmBtn.onclick = function(e) {
                                e.preventDefault();
                                e.stopImmediatePropagation();
                                confirmBtn.disabled = true;

                            if (form && window.htmx) {
                                const formData = new FormData(form);
                                const values = {};
                                for (const [key, value] of formData) {
                                    values[key] = value;
                                }
                                window.htmx.ajax('POST', form.getAttribute('hx-post'), {
                                    target: '#claire-modal-body',
                                    swap: 'innerHTML',
                                    values: values
                                });
                            }
                            };
                            cancelBtn.onclick = function() {
                                confirmBtn.blur();
                                 document.getElementById('claire-modal-root').classList.remove('claire-is-open');
                                 document.getElementById('claire-modal-backdrop').classList.remove('claire-is-visible');
                                 document.body.classList.remove('claire-modal-open');
                                document.getElementById('claire-modal-root').setAttribute('aria-hidden', 'true');
                                confirmBtn.onclick = null;
                            };
                            document.getElementById('claire-modal-backdrop').classList.add('claire-is-visible');
                            document.getElementById('claire-modal-root').classList.add('claire-is-open');
                            document.getElementById('claire-modal-root').setAttribute('aria-hidden', 'false');
                            document.getElementById('claire-modal-root').setAttribute('aria-autoclose', 'false');
                            document.body.classList.add('claire-modal-open');
                        "
                    >
                        <span class="claire-options-item__label">Configuration Telegram</span>
                    </div>
                     <div
                             class="claire-options-item"
                             role="button"
                             tabindex="0"
                              hx-on:click="if (window.claireSession && typeof window.claireSession.clearSession === 'function') { window.claireSession.clearSession(); } sessionStorage.clear(); window.location='{{ base_url }}/logout'"
                             hx-on:keydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); this.click(); }"
                     >
                         <span class="claire-options-item__label">Se déconnecter</span>
                     </div>
                </div>
            </div>
        {% endif %}
    </aside>

    {# Global reusable modal dialog #}
    <div id="claire-modal-backdrop" class="claire-modal-backdrop" aria-hidden="true"></div>
    <div id="claire-modal-root" class="claire-modal" role="dialog" aria-modal="true" aria-autoclose="true" aria-hidden="true" aria-labelledby="claire-modal-title" aria-describedby="claire-modal-body" data-variant="default">
        <div class="claire-modal__container">
            <div class="claire-modal__header">
                <h2 id="claire-modal-title" class="claire-modal__title">Confirmation</h2>
                <button id="claire-modal-close" class="claire-modal__close" type="button" aria-label="Fermer la boîte de dialogue" title="Fermer">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </button>
            </div>
            <div id="claire-modal-body" class="claire-modal__body">Êtes-vous sûr ?</div>
            <div class="claire-modal__footer">
                <button id="claire-modal-cancel" class="claire-btn claire-btn--secondary" type="button">Annuler</button>
                <button id="claire-modal-confirm" class="claire-btn claire-btn--primary" type="button">Confirmer</button>
            </div>
        </div>
    </div>
    <div id="claire-global-action-indicator" class="claire-global-action-indicator htmx-indicator" role="status" aria-live="polite" aria-atomic="true">
        <div class="claire-global-action-indicator__pill">
            <span class="claire-global-action-indicator__spinner" aria-hidden="true"></span>
            <span>Action en cours...</span>
        </div>
    </div>
</div>

<script src="{{ base_url }}/js/htmx.min.js"></script>
<script src="{{ base_url }}/js/sse.js"></script>
<script>
    window.claireRefreshTimeout = {{ settings.get('session.refresh_before_expire')|number_format(0, '.', '') }};
    window.claireRefreshMinInterval = {{ settings.get('session.refresh_min_interval')|number_format(0, '.', '') }};
</script>
<script src="{{ base_url }}/js/session.js"></script>
{% block script %}{% endblock %}
<!-- Global fixed tooltip banner (bottom of the page) -->
<div id="claire-history-tooltip-banner" role="status" aria-live="polite" aria-hidden="true"></div>
<script src="{{ base_url }}/js/app.js"></script>
<script src="{{ base_url }}/js/dialog.js"></script>
</body>
</html>
