{% import '_icon.twig' as icon %}
<div class="claire-option-list claire-files-root">
    <div class="claire-option-list__actions">
        <form action="{{ base_url }}/files/upload" method="post" enctype="multipart/form-data"
              class="claire-file-upload">
            <input class="claire-file-upload__input" id="claire-file-upload-input"
                   type="file" name="file" accept="{{ accepted_ext }}" required>
            <div class="claire-file-upload__icons">
                <label class="claire-btn claire-btn--secondary claire-file-upload__label"
                       for="claire-file-upload-input" aria-label="Parcourir">
                    {{ icon.draw('M12 16V4m0 0L7 9m5-5 5 5M5 14v5h14v-5') }}
                </label>
                <button type="submit" class="claire-btn claire-btn--primary"
                        aria-label="Envoyer" disabled>
                    {{ icon.draw('M4 4l17 8-17 8 3-8zm3 8h14') }}
                </button>
            </div>
            <span class="claire-file-upload__name" aria-live="polite">Aucun fichier</span>
        </form>
    </div>
{% if files is empty %}
    <div class="claire-option-list__empty">
        <div class="claire-option-list__empty-icon">
            {{ icon.draw('M7 3h7l4 4v14H7zM14 3v5h5') }}
        </div>
        <div class="claire-option-list__empty-text">Aucun fichier</div>
        <div class="claire-option-list__empty-help">Ajoutez un fichier à l’aide du bouton ci-dessus.</div>
    </div>
{% else %}
    <ul class="claire-option-list__items">
    {% for file in files %}
        <li class="claire-option-item claire-file-item" id="claire-file-{{ file.fileId }}">
            <div class="claire-option-item__icon">{{ icon.draw('M7 3h7l4 4v14H7zM14 3v5h5') }}</div>
            <div class="claire-option-item__content">
                <div class="claire-option-item__title">{{ file.filename }}</div>
                <div class="claire-option-item__meta">
                    {{ file.mimeType }} •
                    {% if file.sizeBytes < 1024 %}
                        {{ file.sizeBytes }} o
                    {% elseif file.sizeBytes < 1048576 %}
                        {{ (file.sizeBytes / 1024)|number_format(2, ',', ' ') }} Ko
                    {% else %}
                        {{ (file.sizeBytes / 1048576)|number_format(2, ',', ' ') }} Mo
                    {% endif %}
                    • Ajouté le {{ file.createdAt|date('d/m/Y') }}
                </div>
            </div>
            <div class="claire-option-item__actions">
                <button class="claire-option-item__button" type="button"
                        aria-label="Ajouter ce fichier à la conversation"
                        data-add-file-id="{{ file.fileId }}" data-add-file-name="{{ file.filename }}">
                    {{ icon.draw('M12 5v14M5 12h14') }}
                </button>
                <button class="claire-option-item__button claire-files-item__delete" type="button"
                        aria-label="Supprimer ce fichier"
                        data-file-delete="{{ base_url }}/files/delete/{{ file.fileId }}">
                    {{ icon.draw('M4 7h16M9 7V4h6v3m3 0-1 14H7L6 7M10 11v6M14 11v6') }}
                </button>
            </div>
        </li>
    {% endfor %}
    </ul>
{% endif %}
</div>
