<form id="claire-telegram-config-form" class="claire-telegram-config" method="post">
    {% if success %}
        <div class="claire-message claire-message--sent">
            <div class="claire-message__bubble">{{ success }}</div>
        </div>
    {% endif %}
    <div class="claire-telegram-config__section">
        <label for="claire-telegram-id" class="claire-options-item__label">Votre identifiant Telegram</label>
        <input type="number" id="claire-telegram-id" name="telegram_id"
               class="claire-chat-input__field claire-telegram-config__input"
               inputmode="numeric" placeholder="123456789" value="{{ telegram_id }}">
        <p class="claire-telegram-config__help">Entrez votre identifiant numérique Telegram pour recevoir les notifications.</p>
    </div>
    <div class="claire-telegram-config__section">
        <strong>Comment obtenir votre ID Telegram</strong>
        <ol>
            <li>Ouvrez Telegram et cherchez le bot <strong>@userinfobot</strong></li>
            <li>Démarrez une conversation avec ce bot</li>
            <li>Copiez l’identifiant numérique reçu et collez-le ci-dessus</li>
        </ol>
    </div>
</form>
