<form
    id="telegram-config-form"
    hx-post="{{ base_url }}/config/telegram"
    hx-target="#modalBody"
    hx-swap="innerHTML"
    style="display: flex; flex-direction: column; gap: 20px;"
>
    {% if success is defined %}
        <div class="message message--sent" style="max-width: 100%;">
            <div class="message__bubble">{{ success }}</div>
        </div>
        <script>
            (function() {
                const confirmBtn = document.getElementById('modalConfirm');
                if (confirmBtn) {
                    confirmBtn.onclick = null;
                }

                setTimeout(function() {
                    document.getElementById('modalRoot')?.classList.remove('is-open');
                    document.getElementById('modalBackdrop')?.classList.remove('is-visible');
                    document.body?.classList.remove('modal-open');
                }, 1500);
            })();
        </script>
    {% endif %}
    {% if error is defined %}
        <div class="message message--received" style="max-width: 100%;">
            <div class="message__bubble">{{ error }}</div>
        </div>
        <script>
            (function() {
                const confirmBtn = document.getElementById('modalConfirm');
                if (confirmBtn) {
                    confirmBtn.disabled = false;
                }
            })();
        </script>
    {% endif %}

    <div class="options-item" style="cursor: default; flex-direction: column; align-items: stretch; gap: 12px;">
        <label for="telegram-id" class="options-item__label" style="font-weight: 600;">
            Votre identifiant Telegram
        </label>
        <input
            type="number"
            id="telegram-id"
            name="telegram_id"
            class="chat-input__field"
            placeholder="123456789"
            value="{{ telegram_id|default('') }}"
            style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: 12px; padding: 12px 16px;"
        >
        <p style="font-size: 13px; color: var(--text-secondary); margin: 0;">
            Entrez votre identifiant numérique Telegram pour recevoir les notifications.
        </p>
    </div>

    <div class="options-item" style="cursor: default; flex-direction: column; align-items: stretch; gap: 12px; background: rgba(255, 255, 255, 0.04);">
        <span class="options-item__label" style="font-weight: 600;">Comment obtenir votre ID Telegram</span>
        <ol style="font-size: 13px; color: var(--text-secondary); margin: 0; padding-left: 18px; line-height: 1.6;">
            <li>Ouvrez Telegram et cherchez le bot <strong>@userinfobot</strong></li>
            <li>Démarrez une conversation avec ce bot</li>
            <li>Il vous répondra immédiatement avec votre ID numérique</li>
            <li>Copiez ce nombre et collez-le ci-dessus</li>
        </ol>
        <p style="font-size: 12px; color: var(--text-secondary); margin: 8px 0 0 0; font-style: italic;">
            Alternative : utilisez le bot <strong>@myidbot</strong> avec la commande /getid
        </p>
    </div>
</form>
