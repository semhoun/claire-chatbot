{% for tool in toolsCall %}
    <div class="claire-toolcall__text" id="claire-tool-{{ tool.id }}">
        {% if tool.running %}
            <span class="claire-tools-running-flag" style="display:none"></span>
        {% endif %}
        Utilisation de l'outil : {{ tool.name }}<br>
        Paramètres : <br>
        <ul>
            {% for param in tool.inputs %}
                <li>{{ param.name }} : {{ param.value }}</li>
            {% endfor %}
        </ul>
        Réponse : <br>
        {%if tool.result is not empty %}
            <pre class="claire-toolcall__result">{{ tool.result}}</pre>
        {% endif %}
    </div>
{% endfor %}
