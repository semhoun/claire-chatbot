<main class="claire-chat-body" style="position: relative; z-index: 1;">
    <div
        id="claire-chat-stream"
        data-thread-id="{{ current_thread_id }}"
        data-stream-session-id="{{ stream_session_id }}"
        style="display: contents;"
    >
        <div id="claire-messages" class="claire-messages">
            {% include 'partials/messages_list.twig' %}
        </div>
    </div>
    <button
            id="claire-scroll-down-btn"
            class="claire-scroll-down-button"
            type="button"
            aria-label="Descendre au dernier message"
            title="Aller en bas"
    >
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
            <path d="M12 4v12m0 0l-5-5m5 5l5-5M5 20h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
    </button>
</main>

<footer class="claire-chat-input">
    <form class="claire-chat-input__form" id="claire-brain-chat"
          hx-post="{{ base_url }}/brain/messages"
          hx-swap="none"
          hx-encoding="multipart/form-data"
          hx-on::after-request="window.claireClearInput(event)"
          hx-on::before-request="window.claireChatClick(event)"
    >
        <label class="claire-chat-icon-btn claire-chat-icon-btn--upload claire-form-disabler claire-chat-input__toggleable" for="claire-chat-upload" aria-label="Joindre un fichier">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M16.5 6.5L12 2 7.5 6.5l1.41 1.41L11 5.83V16a3 3 0 1 1-6 0V9H3v7a5 5 0 1 0 10 0V5.83l2.09 2.08L16.5 6.5Z"/>
            </svg>
        </label>
        <input type="hidden" name="threadId" value="{{ current_thread_id }}" id="claire-thread-id-input" />
        <input type="hidden" name="sessionId" value="{{ stream_session_id }}" id="claire-session-id-input" />
        <input class="claire-chat-input__file" type="file" id="claire-chat-upload" name="upload_files[]" multiple accept="{{ settings.get('files.upload.acceptedExt') }}" />
        <span id="claire-chat-attached-files-chat" class="claire-chat-attached"></span>
        <span id="claire-chat-attached-files-chat-hidden" hidden></span>
        <textarea
                class="claire-chat-input__field claire-chat-input__field--multiline claire-form-disabler"
                name="message"
                placeholder="Écrivez votre message..."
                rows="1"
                required
        ></textarea>
        <div class="claire-chat-input__actions">
            <button
                    class="claire-chat-icon-btn claire-form-disabler claire-chat-input__toggleable"
                    type="button"
                    aria-label="Annuler le dernier échange"
                    title="Annuler le dernier échange"
                    hx-delete="{{ base_url }}/history/exchange/last"
                    hx-swap="none"
                    hx-indicator="#claire-global-action-indicator"
                    hx-vals="js:{sessionId: window.claireStreamSessionId || ''}"
                    hx-params="threadId,sessionId"
                    hx-on::after-request="window.claireHandleLastExchangeResponse(event)"
            >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9 7H5v4M5.5 10.5A7 7 0 1 1 7 17.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <button class="claire-chat-icon-btn claire-form-disabler" type="submit" aria-label="Envoyer">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3.4 20.6L4.8 14.2 16.2 12 4.8 9.8 3.4 3.4 22 12 3.4 20.6Z"/>
                </svg>
            </button>
        </div>
    </form>
</footer>
