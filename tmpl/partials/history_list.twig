{% import '_icon.twig' as icon %}
<div class="claire-option-list">
{% if histories is empty %}
    <div class="claire-option-list__empty">
        <div class="claire-option-list__empty-icon">
            {{ icon.draw('M4 5h16v12H8l-4 4zM8 9h8M8 13h5') }}
        </div>
        <div class="claire-option-list__empty-text">Aucune conversation pour le moment</div>
        <div class="claire-option-list__empty-help">Envoyez un message pour créer une nouvelle conversation.</div>
    </div>
{% else %}
    <ul class="claire-option-list__items">
    {% for history in histories %}
        {% set summary = history.summary|default('')|trim %}
        <li class="claire-option-item claire-history-item">
            <div class="claire-option-item__icon" aria-hidden="true">
                {{ icon.draw('M4 5h16v12H8l-4 4zM8 9h8M8 13h5') }}
            </div>
            <div class="claire-option-item__content claire-history-item__content"
                 {% if summary %}data-tooltip="{{ summary }}"{% endif %}>
                <div class="claire-option-item__title"{% if summary %} aria-label="{{ summary }}"{% endif %}>
                    {{ history.title|default('Conversation') }}
                </div>
                <div class="claire-option-item__meta">Modifiée le {{ history.updatedAt|date('d/m/Y à H:i') }}</div>
            </div>
            <div class="claire-option-item__actions">
                <button class="claire-option-item__button" type="button"
                        aria-label="Afficher la conversation"
                        data-history-open="{{ base_url }}/history/open/{{ history.threadId }}">
                    {{ icon.draw('M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z') }}
                </button>
                <button class="claire-option-item__button claire-history-item__delete" type="button"
                        aria-label="Supprimer cette conversation"
                        data-history-delete="{{ base_url }}/history/delete/{{ history.threadId }}">
                    {{ icon.draw('M4 7h16M9 7V4h6v3m3 0-1 14H7L6 7M10 11v6M14 11v6') }}
                </button>
            </div>
        </li>
    {% endfor %}
    </ul>
{% endif %}
</div>
