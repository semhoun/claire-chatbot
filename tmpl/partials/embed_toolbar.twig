<nav class="claire-embed-toolbar" role="navigation" aria-label="Menu embed">
    <div class="claire-embed-toolbar__left">
        <img class="claire-embed-toolbar__avatar" src="{{ brain_info.avatar }}" alt="" width="32" height="32">
        <span class="claire-embed-toolbar__title">{{ brain_info.name }}</span>
    </div>
    <div class="claire-embed-toolbar__right">
        {# Nouvelle conversation #}
        <div
            class="claire-embed-toolbar__item"
            role="button"
            tabindex="0"
            aria-label="Nouvelle conversation"
            title="Nouvelle conversation"
            hx-post="{{ base_url }}/history/new"
            hx-swap="none"
            hx-indicator="#claire-global-action-indicator"
            hx-on:keydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); this.click(); }"
            hx-vals="js:{sessionId: window.claireStreamSessionId || ''}"
            hx-on::after-request="
                if (event.detail.successful) {
                    try {
                        const payload = JSON.parse(event.detail.xhr.responseText || '{}');
                        if (payload.threadId && window.claireUpdatePersistentChatStream) {
                            window.claireUpdatePersistentChatStream(payload.threadId);
                        }
                    } catch (e) {}
                    const panel = document.getElementById('claire-options-panel');
                    const bd = document.getElementById('claire-options-backdrop');
                    const toggle = document.querySelector('.claire-options-toggle');
                    if (panel) panel.classList.remove('claire-is-open');
                    if (bd) bd.classList.remove('claire-is-visible');
                    if (toggle) toggle.classList.remove('claire-is-active');
                    const chatBody = document.querySelector('.claire-chat-body');
                    if (chatBody) chatBody.scrollTop = chatBody.scrollHeight;
                    const countUrl = '{{ base_url }}/history/count';
                    if (window.htmx) { htmx.ajax('GET', countUrl, {target: '#claire-history-count-badge', swap: 'innerHTML'}); }
                }
            "
        >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
        </div>

        {# Historique #}
        <div class="claire-embed-toolbar__dropdown">
            <div
                class="claire-embed-toolbar__item"
                id="claire-history-toggle"
                role="button"
                tabindex="0"
                aria-expanded="false"
                aria-controls="claire-history-list"
                aria-label="Historique"
                title="Historique"
            >
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path d="M12 7v5l3 3M12 22C6.5 22 2 17.5 2 12S6.5 2 12 2s10 4.5 10 10-4.5 10-10 10z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span
                    class="claire-embed-toolbar__badge"
                    id="claire-history-count-badge"
                    hx-get="{{ base_url }}/history/count"
                    hx-swap="innerHTML"
                >0</span>
            </div>
            <div id="claire-history-list" class="claire-embed-toolbar__subpanel" aria-live="polite"></div>
        </div>

        {# Fichiers #}
        <div class="claire-embed-toolbar__dropdown">
            <div
                class="claire-embed-toolbar__item"
                id="claire-files-toggle"
                role="button"
                tabindex="0"
                aria-expanded="false"
                aria-controls="claire-files-list"
                aria-label="Fichiers"
                title="Fichiers"
            >
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <polyline points="14 2 14 8 20 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span
                    class="claire-embed-toolbar__badge"
                    id="claire-files-count-badge"
                    hx-get="{{ base_url }}/files/count"
                    hx-swap="innerHTML"
                >0</span>
            </div>
            <div id="claire-files-list" class="claire-embed-toolbar__subpanel claire-files-root" aria-live="polite"></div>
        </div>

        {# Documents RAG #}
        <div
            class="claire-embed-toolbar__item"
            id="claire-rag-toggle"
            role="button"
            tabindex="0"
            aria-label="Documents RAG"
            title="Documents RAG"
            data-open-upload-dialog
            data-upload-context="rag"
        >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>

        {# Préférences #}
        <div class="claire-embed-toolbar__dropdown">
            <div
                class="claire-embed-toolbar__item"
                role="button"
                tabindex="0"
                aria-expanded="false"
                aria-label="Préférences"
                title="Préférences"
            >
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2"/>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <div class="claire-embed-toolbar__subpanel claire-embed-toolbar__subpanel--prefs">
                <div class="claire-embed-toolbar__subpanel-section">
                    <span class="claire-embed-toolbar__subpanel-title">Assistant</span>
                    <span class="claire-brain-selector">
                        <select id="claire-brain-selector" name="brain">
                            {% for b in brains|default([]) %}
                                <option value="{{ b.slug }}" {{ (current_brain|default('claire')) == b.slug ? 'selected' : '' }}>
                                    {{ b.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </span>
                </div>
                {% if comfyui_enabled and comfyui_workflows is not empty %}
                    <div class="claire-embed-toolbar__subpanel-section">
                        <span class="claire-embed-toolbar__subpanel-title">Workflow</span>
                        <span class="claire-brain-selector">
                            <select id="claire-comfyui-workflow-selector" name="comfyui_workflow">
                                {% for workflow in comfyui_workflows %}
                                    <option value="{{ workflow.slug }}" {{ current_comfyui_workflow == workflow.slug ? 'selected' : '' }}>
                                        {{ workflow.label }}
                                    </option>
                                {% endfor %}
                            </select>
                        </span>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Compte #}
        {% if (uinfo is defined) and (uinfo.id != 'default') %}
            <div class="claire-embed-toolbar__dropdown">
                <div
                    class="claire-embed-toolbar__item"
                    role="button"
                    tabindex="0"
                    aria-expanded="false"
                    aria-label="Compte"
                    title="Compte"
                >
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="12" cy="7" r="4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="claire-embed-toolbar__subpanel claire-embed-toolbar__subpanel--account">
                    <div class="claire-embed-toolbar__subpanel-section" aria-current="true">
                        <span class="claire-embed-toolbar__subpanel-title">{{ uinfo.displayName }}</span>
                    </div>
                    <div
                        class="claire-embed-toolbar__subpanel-section"
                        role="button"
                        tabindex="0"
                        hx-get="{{ base_url }}/config/telegram_form"
                        hx-target="#claire-modal-body"
                        hx-swap="innerHTML"
                        hx-on::after-request="
                            document.getElementById('claire-modal-title').textContent = 'Configuration Telegram';
                            const confirmBtn = document.getElementById('claire-modal-confirm');
                            const cancelBtn = document.getElementById('claire-modal-cancel');
                            confirmBtn.textContent = 'Enregistrer';
                            const form = document.getElementById('claire-telegram-config-form');
                            confirmBtn.disabled = false;
                            confirmBtn.onclick = function(e) {
                                e.preventDefault();
                                e.stopImmediatePropagation();
                                confirmBtn.disabled = true;
                                if (form && window.htmx) {
                                    const formData = new FormData(form);
                                    const values = {};
                                    for (const [key, value] of formData) {
                                        values[key] = value;
                                    }
                                    window.htmx.ajax('POST', form.getAttribute('hx-post'), {
                                        target: '#claire-modal-body',
                                        swap: 'innerHTML',
                                        values: values
                                    });
                                }
                            };
                            cancelBtn.onclick = function() {
                                confirmBtn.blur();
                                document.getElementById('claire-modal-root').classList.remove('claire-is-open');
                                document.getElementById('claire-modal-backdrop').classList.remove('claire-is-visible');
                                document.body.classList.remove('claire-modal-open');
                                document.getElementById('claire-modal-root').setAttribute('aria-hidden', 'true');
                                confirmBtn.onclick = null;
                            };
                            document.getElementById('claire-modal-backdrop').classList.add('claire-is-visible');
                            document.getElementById('claire-modal-root').classList.add('claire-is-open');
                            document.getElementById('claire-modal-root').setAttribute('aria-hidden', 'false');
                            document.getElementById('claire-modal-root').setAttribute('aria-autoclose', 'false');
                            document.body.classList.add('claire-modal-open');
                        "
                    >
                        <span class="claire-embed-toolbar__subpanel-title">Configuration Telegram</span>
                    </div>
                    <div
                        class="claire-embed-toolbar__subpanel-section"
                        role="button"
                        tabindex="0"
                        hx-on:click="if (window.claireSession && typeof window.claireSession.clearSession === 'function') { window.claireSession.clearSession(); } sessionStorage.clear(); if (typeof window.destroyClaireEmbed === 'function') { window.destroyClaireEmbed(); }"
                        hx-on:keydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); this.click(); }"
                    >
                        <span class="claire-embed-toolbar__subpanel-title">Se déconnecter</span>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</nav>
