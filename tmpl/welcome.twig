{% extends 'public_base.twig' %}
{% block content %}
    <div class="claire-panel claire-is-centered claire-is-hidden" role="status" id="claire-auth-status">
        <div class="claire-spinner"></div><h1>Connexion en cours...</h1><p>Redirection automatique</p>
    </div>
    <div class="claire-panel" id="claire-sso-panel">
        <h2>Bienvenue</h2><p>Pour continuer, veuillez vous authentifier via notre SSO.</p>
        <a href="{{ base_url }}/auth/sso" class="claire-sso-btn">Se connecter</a>
    </div>
{% endblock %}
{% block scripts %}
<script>
(() => {
    const raw = sessionStorage.getItem('claire_mini_token');
    if (!raw) return;
    try {
        const value = JSON.parse(raw);
        if (!value.token || Date.now() >= value.expiresAt) return;
        document.getElementById('claire-auth-status').classList.remove('claire-is-hidden');
        document.getElementById('claire-sso-panel').classList.add('claire-is-hidden');
        const target = new URL({{ (base_url ~ '/')|json_encode|raw }}, location.origin);
        target.searchParams.set('token', value.token);
        location.replace(target.pathname + target.search);
    } catch {
        sessionStorage.removeItem('claire_mini_token');
    }
})();
</script>
{% endblock %}
