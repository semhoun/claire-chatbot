{% extends 'public_base.twig' %}
{% block content %}
    <div class="claire-panel claire-is-centered claire-is-hidden" role="status" id="claire-auth-status">
        <div class="claire-spinner"></div><h1>Connexion en cours...</h1><p>Redirection automatique</p>
    </div>
    <div class="claire-panel" id="claire-sso-panel">
        <h2>Bienvenue</h2><p>Pour continuer, veuillez vous authentifier via notre SSO.</p>
        <a href="{{ base_url }}/auth/sso" class="claire-sso-btn">Se connecter</a>
    </div>
{% endblock %}
{% block scripts %}
<script>
(async () => {
    const key = 'claire_session_token';
    const status = document.getElementById('claire-auth-status');
    const panel = document.getElementById('claire-sso-panel');
    try {
        sessionStorage.removeItem('claire_mini_token');
        const raw = sessionStorage.getItem(key);
        if (!raw) return;
        const value = JSON.parse(raw);
        if (!value.token || !Number.isFinite(value.expiresAt) || Date.now() >= value.expiresAt) {
            sessionStorage.removeItem(key);
            return;
        }
        status.classList.remove('claire-is-hidden');
        panel.classList.add('claire-is-hidden');
        const target = new URL({{ (base_url ~ '/')|json_encode|raw }}, location.origin);
        if (target.origin !== location.origin) throw new Error('Invalid bootstrap origin');
        const response = await fetch(target, {
            headers: {'X-Claire-Auth': value.token, Accept: 'text/html'},
            redirect: 'error', cache: 'no-store'
        });
        if (!response.ok) throw new Error('Session unavailable');
        const html = await response.text();
        if (!new DOMParser().parseFromString(html, 'text/html').querySelector('#claire-vue-app')) {
            throw new Error('Authenticated bootstrap unavailable');
        }
        const token = response.headers.get('X-Claire-Token');
        if (token) {
            const part = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
            const claims = JSON.parse(atob(part + '==='.slice((part.length + 3) % 4)));
            sessionStorage.setItem(key, JSON.stringify({token, expiresAt: claims.exp * 1000}));
        }
        history.replaceState(null, '', target.pathname + target.search);
        document.open();
        document.write(html);
        document.close();
    } catch {
        sessionStorage.removeItem(key);
        status.classList.add('claire-is-hidden');
        panel.classList.remove('claire-is-hidden');
    }
})();
</script>
{% endblock %}
