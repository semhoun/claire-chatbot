{% extends 'layout_base.twig' %}

{% block content %}
    <div class="panel is-centered is-hidden" role="status" id="auth-status" aria-live="polite">
        <div class="spinner" aria-hidden="true"></div>
        <h1>Connexion en cours...</h1>
        <p>Redirection automatique</p>
    </div>
    <div class="panel" role="dialog" aria-label="Connexion" id="sso-panel">
        <h2>Bienvenue</h2>
        <p>Pour continuer, veuillez vous authentifier via notre SSO.</p>
        <a href="{{ base_url }}/auth/sso" class="sso-btn">Se connecter</a>
    </div>
{% endblock %}

{% block script %}
<script>
    (function () {
        'use strict';

        const miniStorageKey = 'claire_mini_token';
        const authStatus = document.getElementById('auth-status');
        const ssoPanel = document.getElementById('sso-panel');

        function showAuthStatus() {
            if (authStatus) {
                authStatus.classList.remove('is-hidden');
            }

            if (ssoPanel) {
                ssoPanel.classList.add('is-hidden');
            }
        }

        let token = null;
        const rawMini = sessionStorage.getItem(miniStorageKey);
        if (rawMini) {
            try {
                const parsed = JSON.parse(rawMini);
                if (
                    parsed
                    && typeof parsed.token === 'string'
                    && parsed.token !== ''
                    && typeof parsed.expiresAt === 'number'
                    && Date.now() < parsed.expiresAt
                ) {
                    token = parsed.token;
                } else {
                    sessionStorage.removeItem(miniStorageKey);
                }
            } catch (_error) {
                sessionStorage.removeItem(miniStorageKey);
            }
        }

        if (!token) {
            return;
        }

        showAuthStatus();

        const target = new URL('{{ base_url }}/', window.location.origin);
        target.searchParams.set('token', token);
        window.location.replace(target.pathname + target.search + target.hash);
    })();
</script>
{% endblock %}
