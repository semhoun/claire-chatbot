<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Claire - Connexion en cours...</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0f0c29;
            background: linear-gradient(to bottom, #24243e, #302b63, #0f0c29);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: #fff;
        }
        .loading-container {
            text-align: center;
            padding: 40px;
        }
        .spinner {
            width: 48px;
            height: 48px;
            border: 3px solid rgba(255, 255, 255, 0.2);
            border-top-color: #ff7ce5;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        h1 {
            font-size: 20px;
            font-weight: 500;
            margin: 0 0 8px;
        }
        p {
            font-size: 14px;
            opacity: 0.7;
            margin: 0;
        }
    </style>
</head>
<body>
    <div class="loading-container">
        <div class="spinner"></div>
        <h1>Connexion en cours...</h1>
        <p>Redirection automatique</p>
    </div>

    <script>
        (function() {
            'use strict';

            const STORAGE_KEY = 'claire_session_token';
            const SESSION_TOKEN = '{{ session_token|e('js') }}';

            function storeTokenAndRedirect() {
                if (SESSION_TOKEN) {
                    try {
                        sessionStorage.setItem(STORAGE_KEY, SESSION_TOKEN);
                    } catch (e) {
                        console.warn('Failed to store token in sessionStorage:', e);
                    }
                }
                const targetUrl = SESSION_TOKEN
                    ? '/?token=' + encodeURIComponent(SESSION_TOKEN)
                    : '{{ redirect_url|default("/") }}';
                window.location.replace(targetUrl);
            }

            storeTokenAndRedirect();
        })();
    </script>
</body>
</html>
