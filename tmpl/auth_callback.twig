{% extends 'public_base.twig' %}
{% block content %}
    <div class="claire-panel claire-is-centered">
        <div class="claire-spinner"></div><h1>Connexion en cours...</h1><p>Redirection automatique</p>
    </div>
{% endblock %}
{% block scripts %}
<script>
(() => {
    const tokens = [
        ['claire_session_token', {{ session_token|json_encode|raw }}],
        ['claire_mini_token', {{ mini_token|json_encode|raw }}]
    ];
    for (const [key, token] of tokens) {
        if (!token) continue;
        try {
            const part = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
            const data = JSON.parse(atob(part + '==='.slice((part.length + 3) % 4)));
            sessionStorage.setItem(key, JSON.stringify({token, expiresAt: data.exp * 1000}));
        } catch {}
    }
    location.replace({{ redirect_url|json_encode|raw }});
})();
</script>
{% endblock %}
