<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Claire</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#ff3cac">
    <link rel="icon" href="{{ base_url }}/image/icon-192.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ base_url }}/css/style.css">

    <style>
        .claire-app-base {
            width: 100%;
            min-height: 100vh;
        }

        .welcome-page {
            position: relative;
            width: 100%;
            min-height: 100vh;
            background: #000;
            background-image: url('{{ base_url }}/image/background.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }
        .claire-panel {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: min(90vw, 520px);
            text-align: center;
            background: rgba(0, 0, 0, 0.45);
            color: #fff;
            border-radius: 16px;
            padding: 40px;
            box-shadow: 0 14px 34px rgba(0, 0, 0, 0.35);
        }
        .claire-panel h1, .claire-panel h2 {
            margin: 0 0 12px 0;
            font-size: clamp(24px, 4vw, 34px);
            font-weight: 800;
        }
        .claire-panel p {
            margin: 0 0 24px 0;
            font-size: clamp(15px, 2.8vw, 19px);
            color: rgba(255, 255, 255, 0.92);
        }
        .claire-panel.claire-is-centered {
            text-align: center;
        }
        .claire-panel.claire-is-centered p {
            margin: 0;
        }
        .claire-spinner {
            width: 48px;
            height: 48px;
            border: 3px solid rgba(255, 255, 255, 0.2);
            border-top-color: #0d6efd;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        .claire-is-hidden {
            display: none !important;
        }
        .claire-sso-btn {
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            background: rgba(13, 110, 253, 0.72);
            color: #fff;
            cursor: pointer;
            font-weight: 600;
            box-shadow: 0 6px 18px rgba(13, 110, 253, 0.35);
            transition: transform .06s ease, box-shadow .2s ease, background-color .2s ease;
        }
        .claire-sso-btn:hover {
            background: rgba(11, 94, 215, 0.78);
            color: #fef3c7;
            transform: translateY(-1px);
            box-shadow: 0 10px 24px rgba(13, 110, 253, 0.45);
        }
        @media (max-width: 640px) {
            .claire-panel {
                width: min(92vw, 520px);
                padding: 26px;
            }
        }
    </style>
    {% block style %}{% endblock %}
</head>
<body
    id="claire-body"
    style="margin: 0; min-height: 100%; height: 100%;"
>
<div class="claire-app-base">
    <div class="welcome-page">
        {% block content %}{% endblock %}
    </div>
</div>
{% block script %}{% endblock %}
</body>
</html>
