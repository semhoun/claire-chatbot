<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Claire - Paramètres</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        :root {
            --claire-bg-gradient-start: #667eea;
            --claire-bg-gradient-end: #764ba2;
            --claire-glass-bg: rgba(255, 255, 255, 0.15);
            --claire-glass-border: rgba(255, 255, 255, 0.2);
            --claire-glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
            --claire-text-primary: #ffffff;
            --claire-text-secondary: rgba(255, 255, 255, 0.8);
            --claire-accent: #ffd700;
            --claire-danger: #ff4757;
            --claire-success: #2ed573;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, var(--claire-bg-gradient-start) 0%, var(--claire-bg-gradient-end) 100%);
            background-attachment: fixed;
            color: var(--claire-text-primary);
            min-height: 100vh;
            padding: 20px 16px;
            -webkit-font-smoothing: antialiased;
        }

        /* Floating Header */
        .claire-header {
            text-align: center;
            margin-bottom: 20px;
            padding: 10px;
            position: relative;
        }

        .claire-header-close {
            position: absolute;
            top: 0;
            left: 0;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white;
            font-size: 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            z-index: 10;
        }

        .claire-header-close:active {
            transform: scale(0.9);
            background: rgba(255, 255, 255, 0.3);
        }

        .claire-header-close svg,
        .claire-modal-close svg,
        .claire-selection-check svg,
        .claire-option-check svg,
        .claire-action-btn svg {
            width: 18px;
            height: 18px;
        }

        .claire-selection-avatar > svg,
        .claire-option-avatar > svg {
            width: 28px;
            height: 28px;
        }

        .claire-user-avatar {
            width: 160px;
            height: 160px;
            border-radius: 50%;
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 72px;
            margin: 0 auto 12px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
            border: 4px solid rgba(255, 255, 255, 0.3);
            overflow: hidden;
            transition: transform 0.3s ease;
        }

        .claire-user-avatar:active {
            transform: scale(0.95);
        }

        .claire-user-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .claire-header-title {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 8px;
            margin-top: 20px;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
        }

        .claire-header-subtitle {
            font-size: 14px;
            color: var(--claire-text-secondary);
            font-weight: 400;
        }

        .claire-user-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin: 0 auto 10px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
            border: 3px solid rgba(255, 255, 255, 0.3);
            overflow: hidden;
            transition: transform 0.3s ease;
        }

        .claire-user-avatar:active {
            transform: scale(0.95);
        }

        .claire-user-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .claire-header-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 3px;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
        }

        .claire-header-subtitle {
            font-size: 12px;
            color: var(--claire-text-secondary);
            font-weight: 400;
        }

        /* Glass Cards */
        .claire-glass-card {
            background: var(--claire-glass-bg);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid var(--claire-glass-border);
            border-radius: 20px;
            padding: 20px;
            margin-bottom: 16px;
            box-shadow: var(--claire-glass-shadow);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .claire-glass-card:active {
            transform: translateY(2px);
            box-shadow: 0 4px 16px 0 rgba(31, 38, 135, 0.2);
        }

        .claire-card-title {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--claire-text-secondary);
            margin-bottom: 15px;
            font-weight: 600;
        }

        /* Selection Items */
        .claire-selection-item {
            display: flex;
            align-items: center;
            padding: 15px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            margin-bottom: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            border: 1px solid transparent;
        }

        .claire-selection-item:last-child {
            margin-bottom: 0;
        }

        .claire-selection-item:hover {
            background: rgba(255, 255, 255, 0.2);
            border-color: rgba(255, 255, 255, 0.3);
        }

        .claire-selection-item.claire-active {
            background: rgba(255, 255, 255, 0.25);
            border-color: var(--claire-accent);
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.3);
        }

        .claire-selection-avatar {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin-right: 15px;
            flex-shrink: 0;
            overflow: hidden;
        }

        .claire-selection-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .claire-selection-info {
            flex: 1;
        }

        .claire-selection-name {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 3px;
        }

        .claire-selection-desc {
            font-size: 12px;
            color: var(--claire-text-secondary);
        }

        .claire-selection-check {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: var(--claire-accent);
            display: none;
            align-items: center;
            justify-content: center;
            color: #000;
            font-size: 14px;
            font-weight: bold;
        }

        .claire-selection-item.claire-active .claire-selection-check {
            display: flex;
        }

        /* Action Buttons */
        .claire-action-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 20px;
        }

        .claire-action-btn {
            padding: 16px 20px;
            border-radius: 16px;
            border: none;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .claire-action-btn:active {
            transform: scale(0.96);
        }

        .claire-btn-primary {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(245, 87, 108, 0.4);
        }

        .claire-btn-secondary {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .claire-btn-danger {
            background: rgba(255, 71, 87, 0.2);
            color: var(--claire-danger);
            border: 1px solid rgba(255, 71, 87, 0.3);
            grid-column: span 2;
        }

        /* Modal */
        .claire-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
            display: none;
            align-items: flex-end;
            justify-content: center;
            z-index: 1000;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .claire-modal-overlay.claire-active {
            display: flex;
            opacity: 1;
        }

        .claire-modal-content {
            background: linear-gradient(180deg, #2d2d3a 0%, #1a1a2e 100%);
            width: 100%;
            max-height: 80vh;
            border-radius: 30px 30px 0 0;
            overflow: hidden;
            transform: translateY(100%);
            transition: transform 0.3s ease;
        }

        .claire-modal-overlay.claire-active .claire-modal-content {
            transform: translateY(0);
        }

        .claire-modal-header {
            padding: 20px;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
        }

        .claire-modal-title {
            font-size: 18px;
            font-weight: 600;
        }

        .claire-modal-close {
            position: absolute;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: white;
            font-size: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .claire-modal-body {
            padding: 10px 20px 30px;
            max-height: 60vh;
            overflow-y: auto;
        }

        .claire-option-item {
            display: flex;
            align-items: center;
            padding: 15px;
            border-radius: 12px;
            cursor: pointer;
            transition: background 0.2s;
            margin-bottom: 8px;
        }

        .claire-option-item:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .claire-option-item.claire-selected {
            background: rgba(102, 126, 234, 0.3);
        }

        .claire-option-avatar {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            margin-right: 15px;
            overflow: hidden;
            flex-shrink: 0;
        }

        .claire-option-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .claire-option-label {
            flex: 1;
            font-size: 15px;
        }

        .claire-option-check {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

        .claire-option-item.claire-selected .claire-option-check {
            background: var(--claire-success);
            border-color: var(--claire-success);
        }

        /* Toast */
        .claire-toast {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%) translateY(-100px);
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(10px);
            color: white;
            padding: 12px 24px;
            border-radius: 25px;
            font-size: 14px;
            opacity: 0;
            transition: all 0.3s ease;
            z-index: 2000;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .claire-toast.claire-show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }

        /* Loading */
        .claire-loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, var(--claire-bg-gradient-start) 0%, var(--claire-bg-gradient-end) 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 3000;
            transition: opacity 0.3s ease;
        }

        .claire-loading-overlay.hidden {
            opacity: 0;
            pointer-events: none;
        }

        .claire-loader {
            width: 50px;
            height: 50px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .claire-loading-text {
            margin-top: 20px;
            font-size: 16px;
            color: var(--claire-text-secondary);
        }

        ::-webkit-scrollbar {
            width: 0;
            height: 0;
        }
    </style>
</head>
<body>
    <!-- Loading -->
    <div id="claire-loading-overlay" class="claire-loading-overlay">
        <div class="claire-loader"></div>
        <div class="claire-loading-text">Chargement...</div>
    </div>

    <!-- Header -->
    <div class="claire-header">
        <button class="claire-header-close" id="claire-close-btn" aria-label="Fermer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
        <div class="claire-header-title">Claire</div>
        <div class="claire-header-subtitle">Personnalisez votre expérience</div>
    </div>

    <!-- Brain Selection -->
    <div class="claire-glass-card">
        <div class="claire-card-title">Assistant</div>
        <div class="claire-selection-item" id="claire-brain-selector">
            <div class="claire-selection-avatar" id="claire-brain-avatar"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4h6M12 2v2M6 8h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2zm2 5h.01M16 13h.01M8 17h8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <div class="claire-selection-info">
                <div class="claire-selection-name" id="claire-brain-name">Chargement...</div>
                <div class="claire-selection-desc" id="claire-brain-desc">Sélectionnez un assistant</div>
            </div>
            <div class="claire-selection-check"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4L19 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        </div>
    </div>

    {% if comfyui_enabled and workflows is not empty %}
    <!-- Workflow Selection -->
    <div class="claire-glass-card">
        <div class="claire-card-title">Workflow ComfyUI</div>
        <div class="claire-selection-item" id="claire-workflow-selector">
            <div class="claire-selection-avatar" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18h2a2 2 0 0 0 0-4h-1a2 2 0 0 1 0-4h5a3 3 0 0 0 3-3c0-4-4-7-9-7zM7.5 10h.01M9 6.5h.01M14 6h.01M17 9h.01" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <div class="claire-selection-info">
                <div class="claire-selection-name" id="claire-workflow-name">Chargement...</div>
                <div class="claire-selection-desc">Style de génération d'images</div>
            </div>
            <div class="claire-selection-check"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4L19 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        </div>
    </div>
    {% endif %}

    <!-- Long-term memory -->
    <div class="claire-glass-card">
        <div class="claire-card-title">Mémoire</div>
        <div class="claire-selection-item" id="claire-memory-selector">
            <div class="claire-selection-avatar"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4a3 3 0 0 0-3 3v1a3 3 0 0 0-1 5v1a3 3 0 0 0 3 3h1v3m6-16a3 3 0 0 1 3 3v1a3 3 0 0 1 1 5v1a3 3 0 0 1-3 3h-1v3M9 4a3 3 0 0 1 3 3v13M15 4a3 3 0 0 0-3 3M8 10h4m4 3h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <div class="claire-selection-info">
                <div class="claire-selection-name" id="claire-memory-name">Chargement...</div>
                <div class="claire-selection-desc">Conserver les informations utiles entre les conversations</div>
            </div>
            <div class="claire-selection-check"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4L19 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        </div>
    </div>

    {% if audio_available and audio_voices is not empty %}
    <!-- Audio voice -->
    <div class="claire-glass-card">
        <div class="claire-card-title">Voix</div>
        <div class="claire-selection-item" id="claire-voice-selector">
            <div class="claire-selection-avatar"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 10v4h3l4 4V6L8 10zm10-1a4 4 0 0 1 0 6m2-8a7 7 0 0 1 0 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <div class="claire-selection-info">
                <div class="claire-selection-name" id="claire-voice-name">Chargement...</div>
                <div class="claire-selection-desc">Voix des réponses aux notes vocales</div>
            </div>
            <div class="claire-selection-check"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4L19 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        </div>
    </div>
    {% endif %}

    <!-- Actions -->
    <div class="claire-action-grid">
        <button class="claire-action-btn claire-btn-primary" id="claire-new-chat-btn" style="grid-column: span 2;">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v12H8l-4 4zM8 9h8M8 13h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> Nouvelle conversation
        </button>
        <button class="claire-action-btn" id="claire-rebuild-memory-btn" style="grid-column: span 2;">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4a3 3 0 0 0-3 3v1a3 3 0 0 0-1 5v1a3 3 0 0 0 3 3h1v3m6-16a3 3 0 0 1 3 3v1a3 3 0 0 1 1 5v1a3 3 0 0 1-3 3h-1v3M9 4a3 3 0 0 1 3 3v13M15 4a3 3 0 0 0-3 3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> Reconstruire la mémoire depuis l'historique
        </button>
    </div>

    <!-- Modal -->
    <div class="claire-modal-overlay" id="claire-modal-overlay">
        <div class="claire-modal-content">
            <div class="claire-modal-header">
                <div class="claire-modal-title" id="claire-modal-title">Sélectionner</div>
                <button class="claire-modal-close" id="claire-modal-close" aria-label="Fermer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
            </div>
            <div class="claire-modal-body" id="claire-modal-body"></div>
        </div>
    </div>

    <!-- Toast -->
    <div class="claire-toast" id="claire-toast"></div>

    <script>
        const baseUrl = {{ base_url|json_encode|raw }};
        const brains = {{ brains|json_encode|raw }};
        const workflows = {{ workflows|json_encode|raw }};
        const comfyuiEnabled = {{ comfyui_enabled|json_encode|raw }};
        const audioAvailable = {{ audio_available|json_encode|raw }};
        const audioVoices = {{ audio_voices|json_encode|raw }};
        const svgIcon = (path) => `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${path}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
        const icons = {
            brain: svgIcon('M9 4a3 3 0 0 0-3 3v1a3 3 0 0 0-1 5v1a3 3 0 0 0 3 3h1v3m6-16a3 3 0 0 1 3 3v1a3 3 0 0 1 1 5v1a3 3 0 0 1-3 3h-1v3M9 4a3 3 0 0 1 3 3v13M15 4a3 3 0 0 0-3 3'),
            check: svgIcon('M5 12l4 4L19 6'),
            palette: svgIcon('M12 3a9 9 0 1 0 0 18h2a2 2 0 0 0 0-4h-1a2 2 0 0 1 0-4h5a3 3 0 0 0 3-3c0-4-4-7-9-7zM7.5 10h.01M9 6.5h.01M14 6h.01M17 9h.01'),
            pause: svgIcon('M9 5v14M15 5v14'),
            robot: svgIcon('M9 4h6M12 2v2M6 8h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2zm2 5h.01M16 13h.01M8 17h8')
        };

        const tg = window.Telegram.WebApp;
        tg.ready();
        tg.expand();

        const initData = tg.initData;

        // DOM elements
        const loadingOverlay = document.getElementById('claire-loading-overlay');
        const brainSelector = document.getElementById('claire-brain-selector');
        const brainAvatar = document.getElementById('claire-brain-avatar');
        const brainName = document.getElementById('claire-brain-name');
        const brainDesc = document.getElementById('claire-brain-desc');
        const workflowSelector = document.getElementById('claire-workflow-selector');
        const workflowName = document.getElementById('claire-workflow-name');
        const memorySelector = document.getElementById('claire-memory-selector');
        const memoryName = document.getElementById('claire-memory-name');
        const voiceSelector = document.getElementById('claire-voice-selector');
        const voiceName = document.getElementById('claire-voice-name');
        const closeBtn = document.getElementById('claire-close-btn');
        const newChatBtn = document.getElementById('claire-new-chat-btn');
        const rebuildMemoryBtn = document.getElementById('claire-rebuild-memory-btn');
        const modalOverlay = document.getElementById('claire-modal-overlay');
        const modalTitle = document.getElementById('claire-modal-title');
        const modalBody = document.getElementById('claire-modal-body');
        const modalClose = document.getElementById('claire-modal-close');
        const toast = document.getElementById('claire-toast');

        let currentSettings = {};

        // Load settings
        async function loadSettings() {
            if (!initData) {
                showToast('Erreur: Ouvrir via Telegram');
                return;
            }

            try {
                const response = await fetch(`${baseUrl}/telegram/webapp/api`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ initData })
                });

                const data = await response.json();

                if (data.success) {
                    currentSettings = data.settings;
                    updateUI(data.settings);
                    loadingOverlay.classList.add('hidden');
                } else {
                    showToast(data.error || 'Erreur');
                }
            } catch (error) {
                showToast('Erreur de connexion');
                console.error(error);
            }
        }

        function updateUI(settings) {
            const brain = brains.find(b => b.slug === settings.brain_avatar);
            if (brain) {
                brainName.textContent = brain.name;
                brainDesc.textContent = brain.description || 'Assistant personnel';
                
                // Update avatars
                if (brain.avatar) {
                    const avatarHtml = getAvatarHtml(brain.avatar);
                    brainAvatar.innerHTML = avatarHtml;
                } else {
                    brainAvatar.innerHTML = icons.robot;
                }
                
                brainSelector.classList.add('claire-active');
            }

            if (comfyuiEnabled && workflows.length > 0) {
                const workflow = workflows.find(w => w.slug === settings.comfyui_workflow);
                workflowName.textContent = workflow ? workflow.label : 'Non défini';
                if (workflow) workflowSelector.classList.add('claire-active');
            }

            const memoryEnabled = settings.long_term_memory_enabled === true;
            memoryName.textContent = memoryEnabled ? 'Activée' : 'Désactivée';
            memorySelector.classList.toggle('claire-active', memoryEnabled);

            if (audioAvailable && voiceSelector && voiceName) {
                const voice = audioVoices.find(v => v.id === settings.audio_voice);
                voiceName.textContent = voice ? voice.label : 'Voix par défaut';
                voiceSelector.classList.toggle('claire-active', Boolean(voice));
            }
        }

        function getAvatarHtml(avatar) {
            if (avatar.startsWith('http') || avatar.startsWith('/') || avatar.startsWith('data:')) {
                return `<img src="${avatar}" alt="">`;
            }
            return avatar.startsWith('<svg') ? avatar : icons.robot;
        }

        // Modal functions
        function openModal(title, options, selectedValue, onSelect) {
            modalTitle.textContent = title;
            modalBody.innerHTML = '';

            options.forEach(opt => {
                const div = document.createElement('div');
                div.className = 'claire-option-item' + (opt.value === selectedValue ? ' claire-selected' : '');
                
                let avatarHtml = '';
                if (opt.avatar) {
                    avatarHtml = `<div class="claire-option-avatar">${getAvatarHtml(opt.avatar)}</div>`;
                }

                div.innerHTML = `
                    ${avatarHtml}
                    <div class="claire-option-label">${opt.label}</div>
                    <div class="claire-option-check">${icons.check}</div>
                `;
                
                div.onclick = () => {
                    onSelect(opt.value);
                    closeModal();
                };
                modalBody.appendChild(div);
            });

            modalOverlay.classList.add('claire-active');
        }

        function closeModal() {
            modalOverlay.classList.remove('claire-active');
        }

        // Brain selection
        brainSelector.addEventListener('click', () => {
            const options = brains.map(b => ({ value: b.slug, label: b.name, avatar: b.avatar }));
            openModal('Choisir un assistant', options, currentSettings.brain_avatar, async (value) => {
                await saveSetting('brain_avatar', value);
            });
        });

        // Workflow selection
        if (workflowSelector) {
            workflowSelector.addEventListener('click', () => {
                const options = workflows.map(w => ({ 
                    value: w.slug, 
                    label: w.label,
                    avatar: icons.palette
                }));
                openModal('Choisir un workflow', options, currentSettings.comfyui_workflow || '', async (value) => {
                    await saveSetting('comfyui_workflow', value);
                });
            });
        }

        memorySelector.addEventListener('click', () => {
            const options = [
                { value: true, label: 'Activée', avatar: icons.brain },
                { value: false, label: 'Désactivée', avatar: icons.pause }
            ];
            openModal(
                'Mémoire longue durée',
                options,
                currentSettings.long_term_memory_enabled === true,
                async (value) => {
                    await saveSetting('long_term_memory_enabled', value);
                }
            );
        });

        if (voiceSelector) {
            voiceSelector.addEventListener('click', () => {
                const options = audioVoices.map(v => ({ value: v.id, label: v.label }));
                openModal('Choisir une voix', options, currentSettings.audio_voice || '', async (value) => {
                    await saveSetting('audio_voice', value);
                });
            });
        }

        // Save setting
        async function saveSetting(key, value) {
            try {
                const response = await fetch(`${baseUrl}/telegram/webapp/api`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ initData, [key]: value })
                });

                const data = await response.json();

                if (data.success) {
                    currentSettings[key] = value;
                    updateUI(currentSettings);
                    showToast('Enregistré');
                    tg.HapticFeedback.notificationOccurred('success');
                } else {
                    showToast(data.error || 'Erreur');
                }
            } catch (error) {
                showToast('Erreur de connexion');
                console.error(error);
            }
        }

        // New chat
        rebuildMemoryBtn.addEventListener('click', () => {
            if (currentSettings.long_term_memory_enabled !== true) {
                showToast('Activez d’abord la mémoire longue durée');
                return;
            }

            tg.showConfirm(
                'Remplacer la mémoire actuelle à partir de tout votre historique ?',
                async (confirmed) => {
                    if (!confirmed) return;
                    rebuildMemoryBtn.disabled = true;
                    showToast('Reconstruction en cours…');
                    try {
                        const response = await fetch(`${baseUrl}/telegram/webapp/api`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ initData, action: 'rebuild_long_term_memory' })
                        });
                        const data = await response.json();
                        showToast(data.success ? 'Mémoire reconstruite' : (data.error || 'Erreur'));
                    } catch (error) {
                        showToast('Erreur de connexion');
                        console.error(error);
                    } finally {
                        rebuildMemoryBtn.disabled = false;
                    }
                }
            );
        });

        // New chat
        newChatBtn.addEventListener('click', async () => {
            try {
                const response = await fetch(`${baseUrl}/telegram/webapp/api`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ initData, action: 'new_chat' })
                });

                const data = await response.json();

                if (data.success) {
                    showToast('Nouvelle conversation !');
                    tg.HapticFeedback.notificationOccurred('success');
                    setTimeout(() => tg.close(), 800);
                } else {
                    showToast(data.error || 'Erreur');
                }
            } catch (error) {
                showToast('Erreur de connexion');
                console.error(error);
            }
        });

        // Close
        closeBtn.addEventListener('click', () => tg.close());
        modalClose.addEventListener('click', closeModal);
        modalOverlay.addEventListener('click', (e) => {
            if (e.target === modalOverlay) closeModal();
        });

        // Toast
        function showToast(message) {
            toast.textContent = message;
            toast.classList.add('claire-show');
            setTimeout(() => toast.classList.remove('claire-show'), 3000);
        }

        // Initialize
        loadSettings();
    </script>
</body>
</html>
