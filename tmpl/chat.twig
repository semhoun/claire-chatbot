{% extends 'layout.twig' %}

{% block app %}
<section class="chat-panel">
    <div class="chat-shell">
        <header class="chat-header">
            <div class="chat-header__main">
                <img class="chat-header__avatar" src="{{ brain_info.avatar }}">
                <div class="chat-header__info">
                    <span class="chat-header__title">{{ brain_info.name }}</span>
                    <span class="chat-header__subtitle">{{ brain_info.description }}</span>
                </div>
            </div>
            <button
                    class="options-toggle"
                    type="button"
                    aria-label="Ouvrir le menu"
                    aria-expanded="false"
                    hx-on:click="
                        this.classList.toggle('is-active');
                        const expanded = this.classList.contains('is-active');
                        this.setAttribute('aria-expanded', expanded);
                        const panel = document.getElementById('optionsPanel');
                        if (panel) { panel.classList.toggle('is-open'); }
                        const bd = document.getElementById('optionsBackdrop');
                        if (bd) { bd.classList.toggle('is-visible', expanded); }
                        // Rafraîchir le compteur d'historiques à l'ouverture du menu
                        if (expanded) {
                            const historyCountUrl = '{{ base_url }}/history/count';
                            const filesCountUrl = '{{ base_url }}/files/count';
                            if (window.htmx) {
                                htmx.ajax('GET', historyCountUrl, {target: '#historyCountBadge', swap: 'innerHTML'});
                                htmx.ajax('GET', filesCountUrl, {target: '#filesCountBadge', swap: 'innerHTML'});
                            }
                        }
                    "
                >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>
        </header>

        <main class="chat-body" style="position: relative; z-index: 1;">
            {# HTMX SSE container for chat snapshots - handles full message list updates #}
            <div
                id="chatStream"
                hx-ext="sse"
                sse-connect="{{ base_url }}/brain/stream?chatId={{ current_chat_id }}"
                sse-swap="chat.snapshot"
                hx-target="#messages"
                hx-swap="innerHTML"
                data-chat-id="{{ current_chat_id }}"
                style="display: contents;"
            >
                <div id="messages" class="messages" data-chat-messages data-chat-id="{{ current_chat_id }}">
                    {% if messages is defined and messages is not null and messages is not empty %}
                        {% for m in messages %}
                            {% include 'partials/message.twig' with {
                                message: m.message,
                                time: m.time,
                                sent: m.sent,
                                toolCallId: m.toolCallId,
                                toolCall: m.toolText,
                            } %}
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
            <div id="typingIndicator" class="typing-indicator htmx-indicator" aria-hidden="true">
                <span class="typing-indicator__dot"></span>
                <span class="typing-indicator__dot"></span>
                <span class="typing-indicator__dot"></span>
            </div>
            <button
                    id="scrollDownBtn"
                    class="scroll-down-button"
                    type="button"
                    aria-label="Descendre au dernier message"
                    title="Aller en bas"
            >
                <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
                    <path d="M12 4v12m0 0l-5-5m5 5l5-5M5 20h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
            </button>
        </main>

        <footer class="chat-input">
            <form class="chat-input__form" id="brain_chat"
                  hx-post="{{ base_url }}/brain/messages"
                  hx-swap="none"
                  hx-indicator="#typingIndicator"
                  hx-encoding="multipart/form-data"
                  hx-on::after-request="clearInput(event)"
                  hx-on::before-request="chatClick(event)"
            >
                <label class="chat-icon-btn chat-icon-btn--upload form_disabler chat-input__toggleable" for="chat-upload" aria-label="Joindre un fichier">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M16.5 6.5L12 2 7.5 6.5l1.41 1.41L11 5.83V16a3 3 0 1 1-6 0V9H3v7a5 5 0 1 0 10 0V5.83l2.09 2.08L16.5 6.5Z"/>
                    </svg>
                </label>
                <input type="hidden" name="mode" value="stream" />
                <input type="hidden" name="chatId" value="{{ current_chat_id }}" data-current-chat-id-input />
                <input class="chat-input__file" type="file" id="chat-upload" name="upload_files[]" multiple accept="{{ settings.get('files.upload.acceptedExt') }}" />
                <span id="chatAttachedFilesChat" class="chat-attached"></span>
                <span id="chatAttachedFilesChatHidden" hidden></span>
                <textarea
                        class="chat-input__field chat-input__field--multiline form_disabler"
                        name="message"
                        placeholder="Écrivez votre message..."
                        rows="1"
                        required
                ></textarea>
                <div class="chat-input__actions">
                    <button
                            class="chat-icon-btn form_disabler chat-input__toggleable"
                            type="button"
                            aria-label="Annuler le dernier échange"
                            title="Annuler le dernier échange"
                            hx-delete="{{ base_url }}/history/exchange/last"
                            hx-swap="none"
                            hx-indicator="#globalActionIndicator"
                            hx-on::after-request="handleLastExchangeResponse(event)"
                    >
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M9 7H5v4M5.5 10.5A7 7 0 1 1 7 17.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    <button class="chat-icon-btn form_disabler" type="submit" aria-label="Envoyer">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3.4 20.6L4.8 14.2 16.2 12 4.8 9.8 3.4 3.4 22 12 3.4 20.6Z"/>
                        </svg>
                    </button>
                </div>
            </form>
        </footer>
    </div>
</section>
{% endblock %}

{% block script %}
<script>
    // Gestion locale des pièces jointes: chips avec suppression + synchronisation du formulaire
    // Hybrid SSE: HTMX SSE handles chat.snapshot, native EventSource handles incremental updates
    (function () {
        console.log('[chat:sse] chat script loaded (hybrid mode)');

        // Native EventSource for incremental updates only (placeholder, delta, tool.update)
        // HTMX SSE handles chat.snapshot via sse-swap
        document.addEventListener('DOMContentLoaded', function() {
            const chatStreamContainer = document.getElementById('chatStream');
            const chatId = chatStreamContainer ? chatStreamContainer.getAttribute('data-chat-id') : null;

            if (!chatId) {
                console.error('[chat:sse] no chatId found');
                return;
            }

            console.log('[chat:sse] initializing incremental EventSource for chat:', chatId);
            initIncrementalEventSource(chatId);
        });

        function initIncrementalEventSource(chatId) {
            // Close existing connection if any
            if (window.chatIncrementalEventSource) {
                window.chatIncrementalEventSource.close();
            }

            // Create new EventSource connection for incremental updates
            // The stream endpoint now filters to only send non-snapshot events to this connection
            const sseUrl = '{{ base_url }}/brain/stream?chatId=' + encodeURIComponent(chatId) + '&mode=incremental';
            window.chatIncrementalEventSource = new EventSource(sseUrl);

            window.chatIncrementalEventSource.onopen = function() {
                console.log('[chat:sse] incremental EventSource connection opened');
            };

            window.chatIncrementalEventSource.onmessage = function(event) {
                console.log('[chat:sse] incremental message received:', event.data.slice(0, 200));

                try {
                    const update = JSON.parse(event.data);

                    // Handle HTML updates for incremental content (placeholder, delta, tool.update)
                    if (update.html) {
                        Object.entries(update.html).forEach(([elementId, htmlContent]) => {
                            const mode = update.mode || 'replace';
                            let element = document.getElementById(elementId);

                            if (mode === 'append' && elementId === 'messages') {
                                element = document.getElementById('messages');
                                if (element) {
                                    const loader = element.querySelector('[data-role="assistant-loader"]');
                                    if (loader) {
                                        loader.outerHTML = htmlContent;
                                    } else {
                                        element.insertAdjacentHTML('beforeend', htmlContent);
                                    }
                                    console.log('[chat:sse] appended/replaced placeholder in messages');
                                }
                            } else if (update.event === 'tool.update' && update.toolCallId) {
                                const articleTarget = update.messageId ? document.getElementById(update.messageId) : null;
                                if (articleTarget) {
                                    let toolNode = document.getElementById(update.toolCallId);
                                    if (!toolNode) {
                                        const bubble = articleTarget.closest('.message')?.querySelector('.message__bubble') || articleTarget.parentElement;
                                        if (bubble) {
                                            bubble.insertAdjacentHTML('afterbegin', '<div class="message__subbubble message__subbubble--toolcall"><details class="toolcall" open><summary class="toolcall__summary" aria-label="Appels d\'outils" title="Appels d\'outils"><span class="visually-hidden">Appels d\'outils</span></summary><div class="toolcall__text" id="' + update.toolCallId + '"></div></details></div>');
                                            toolNode = document.getElementById(update.toolCallId);
                                        }
                                    }
                                    if (toolNode) {
                                        toolNode.innerHTML = htmlContent;
                                        console.log('[chat:sse] created/updated tool target:', update.toolCallId);
                                    }
                                }
                            } else if (element) {
                                element.innerHTML = htmlContent;
                                console.log('[chat:sse] updated element:', elementId, 'length:', htmlContent.length, 'mode:', mode);

                                // Scroll to bottom after update
                                const chatBody = document.querySelector('.chat-body');
                                if (chatBody) {
                                    chatBody.scrollTop = chatBody.scrollHeight;
                                }
                            } else {
                                console.warn('[chat:sse] element not found:', elementId, 'mode:', mode, 'event:', update.event);
                            }
                        });
                    }

                    // Handle JS execution
                    if (update.js) {
                        Object.entries(update.js).forEach(([key, value]) => {
                            if (key === 'exec') {
                                eval(value);
                                console.log('[chat:sse] executed JS:', value);
                            } else {
                                window[key] = value;
                                console.log('[chat:sse] set window.' + key + ':', value);
                            }
                        });
                    }

                    if (update.error) {
                        const messages = document.getElementById('messages');
                        if (messages) {
                            const loader = messages.querySelector('[data-role="assistant-loader"]');
                            if (loader) {
                                loader.remove();
                            }
                            messages.insertAdjacentHTML('beforeend', '<article class="message message--received"><div class="message__bubble"><span class="message__text">' + update.error + '</span></div></article>');
                        }
                    }
                } catch (error) {
                    console.error('[chat:sse] error processing incremental message:', error);
                    console.error('[chat:sse] raw data:', event.data);
                }
            };

            window.chatIncrementalEventSource.onerror = function(error) {
                console.error('[chat:sse] incremental EventSource error:', error);
                window.chatIncrementalEventSource.close();

                // Attempt reconnection after 5 seconds
                setTimeout(function() {
                    console.log('[chat:sse] attempting incremental reconnection...');
                    initIncrementalEventSource(chatId);
                }, 5000);
            };
        }

        window.addEventListener('load', function () {
            console.log('[chat:sse] window loaded (hybrid mode)', {
                hasHtmx: Boolean(window.htmx),
                messagesNode: Boolean(document.getElementById('messages')),
                initialMessagesLength: document.getElementById('messages') ? document.getElementById('messages').innerHTML.length : null,
            });
        });

        window.chatClick = function chatClick(event) {
            const form = event.target;
            const disablers = form.querySelectorAll('.form_disabler');
            disablers.forEach(el => { el.setAttribute('disabled', true); });
            form.classList.add('is-busy');

            const input = form.querySelector('[name="message"]');
            if (!input) return;
            const text = (input.value || '').trim();
            if (!text) return;

            const messages = document.getElementById('messages');
            const chatBody = document.querySelector('.chat-body');
            const scrollBtn = document.getElementById('scrollDownBtn');
            if (!messages || !chatBody) return;

            const time = new Date().toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'});
            const wrapper = document.createElement('div');
            wrapper.innerHTML = '<article class="message message--sent"><div class="message__bubble"></div><span class="message__meta"></span></article>';
            const article = wrapper.firstElementChild;
            article.querySelector('.message__bubble').textContent = text;
            article.querySelector('.message__meta').textContent = time + ' • Vous';
            messages.appendChild(article);

            const loader = document.createElement('article');
            loader.className = 'message';
            loader.setAttribute('data-role', 'assistant-loader');
            loader.innerHTML = '<div class="message__bubble">Claire réfléchit...</div>';
            messages.appendChild(loader);

            chatBody.scrollTop = chatBody.scrollHeight;
            if (scrollBtn) scrollBtn.style.display = 'none';
        };

        function autoResizeComposer(input) {
            if (!input) return;
            input.style.height = 'auto';
            input.style.height = Math.min(input.scrollHeight, 160) + 'px';
        }

        function updateComposerToggleState(input) {
            if (!input) return;
            const form = input.closest('form');
            if (!form) return;
            form.classList.toggle('chat-input__form--typing', input.value.trim() !== '');
        }

        window.clearInput = function clearInput(event) {
            const form = event.target;
            const disablers = form.querySelectorAll('.form_disabler');
            disablers.forEach(el => { el.removeAttribute('disabled'); });
            form.classList.remove('is-busy');

            if (!event.detail.successful) return;

            event.target.reset();
            document.querySelectorAll('.chat-chip__remove').forEach(el => removeChatChip(el));

            const input = form.querySelector('[name="message"]');
            autoResizeComposer(input);
            updateComposerToggleState(input);
        };

        window.updatePersistentChatStream = function updatePersistentChatStream(chatId) {
            const chatStreamContainer = document.getElementById('chatStream');
            const messagesContainer = document.getElementById('messages');
            const chatIdInput = document.querySelector('[data-current-chat-id-input]');

            if (!chatStreamContainer || !chatId) {
                console.debug('[chat:sse] skip stream update', { hasContainer: Boolean(chatStreamContainer), chatId });
                return;
            }

            console.debug('[chat:sse] updating chat stream to:', chatId);

            // Update data attributes
            chatStreamContainer.setAttribute('data-chat-id', chatId);
            if (messagesContainer) messagesContainer.setAttribute('data-chat-id', chatId);
            if (chatIdInput) chatIdInput.value = chatId;

            // Update HTMX SSE connection URL
            const newSseUrl = '{{ base_url }}/brain/stream?chatId=' + encodeURIComponent(chatId);
            chatStreamContainer.setAttribute('sse-connect', newSseUrl);

            // Reprocess HTMX SSE extension to pick up new URL
            if (window.htmx) {
                window.htmx.process(chatStreamContainer);
            }

            // Close and reopen incremental EventSource with new chatId
            if (window.chatIncrementalEventSource) {
                window.chatIncrementalEventSource.close();
            }

            const incrementalUrl = newSseUrl + '&mode=incremental';
            window.chatIncrementalEventSource = new EventSource(incrementalUrl);

            window.chatIncrementalEventSource.onmessage = function(event) {
                try {
                    const update = JSON.parse(event.data);
                    if (update.html) {
                        Object.entries(update.html).forEach(([elementId, htmlContent]) => {
                            const mode = update.mode || 'replace';
                            let element = document.getElementById(elementId);
                            if (mode === 'append' && elementId === 'messages') {
                                element = document.getElementById('messages');
                                if (element) {
                                    const loader = element.querySelector('[data-role="assistant-loader"]');
                                    if (loader) {
                                        loader.outerHTML = htmlContent;
                                    } else {
                                        element.insertAdjacentHTML('beforeend', htmlContent);
                                    }
                                }
                            } else if (update.event === 'tool.update' && update.toolCallId) {
                                const articleTarget = update.messageId ? document.getElementById(update.messageId) : null;
                                if (articleTarget) {
                                    let toolNode = document.getElementById(update.toolCallId);
                                    if (!toolNode) {
                                        const bubble = articleTarget.closest('.message')?.querySelector('.message__bubble') || articleTarget.parentElement;
                                        if (bubble) {
                                            bubble.insertAdjacentHTML('afterbegin', '<div class="message__subbubble message__subbubble--toolcall"><details class="toolcall" open><summary class="toolcall__summary" aria-label="Appels d\'outils" title="Appels d\'outils"><span class="visually-hidden">Appels d\'outils</span></summary><div class="toolcall__text" id="' + update.toolCallId + '"></div></details></div>');
                                            toolNode = document.getElementById(update.toolCallId);
                                        }
                                    }
                                    if (toolNode) {
                                        toolNode.innerHTML = htmlContent;
                                    }
                                }
                            } else if (element) {
                                element.innerHTML = htmlContent;
                            }
                            const chatBody = document.querySelector('.chat-body');
                            if (chatBody) chatBody.scrollTop = chatBody.scrollHeight;
                        });
                    }

                    if (update.js) {
                        Object.entries(update.js).forEach(([key, value]) => {
                            if (key === 'exec') {
                                eval(value);
                            } else {
                                window[key] = value;
                            }
                        });
                    }

                    if (update.error) {
                        const messages = document.getElementById('messages');
                        if (messages) {
                            const loader = messages.querySelector('[data-role="assistant-loader"]');
                            if (loader) {
                                loader.remove();
                            }
                            messages.insertAdjacentHTML('beforeend', '<article class="message message--received"><div class="message__bubble"><span class="message__text">' + update.error + '</span></div></article>');
                        }
                    }
                } catch (error) {
                    console.error('[chat:sse] incremental error:', error);
                }
            };

            window.chatIncrementalEventSource.onerror = function(error) {
                console.error('[chat:sse] incremental EventSource error:', error);
                window.chatIncrementalEventSource.close();
                setTimeout(function() {
                    initIncrementalEventSource(chatId);
                }, 5000);
            };
        };

        window.handleLastExchangeResponse = function handleLastExchangeResponse(event) {
            const detail = event.detail || {};
            if (!detail.successful) return;

            try {
                const payload = JSON.parse(detail.xhr.responseText || '{}');
                if (payload.chatId && window.updatePersistentChatStream) {
                    window.updatePersistentChatStream(payload.chatId);
                }
            } catch (e) {}

            const chatBody = document.querySelector('.chat-body');
            if (chatBody) chatBody.scrollTop = chatBody.scrollHeight;
        };

        function $(sel, root=document) { return root.querySelector(sel); }
        function chipSelectorById(id) { return '.chat-chip[data-file-id="' + CSS.escape(String(id)) + '"]'; }

        const containers = {
            chat: {
                chips: $('#chatAttachedFilesChat'),
                hidden: $('#chatAttachedFilesChatHidden'),
                fileInput: $('#chat-upload'),
            },
            stream: {
                chips: $('#chatAttachedFilesStream'),
                hidden: $('#chatAttachedFilesStreamHidden'),
                fileInput: $('#chat-upload-stream'),
            }
        };

        function svgFileIcon() {
            return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h7l5 5v15H6z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M13 2v6h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>';
        }
        function removeBtn() {
            return '<button type="button" class="chat-chip__remove" aria-label="Retirer" title="Retirer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>';
        }

        function createIdChip(fileId, fileName) {
            const chip = document.createElement('span');
            chip.className = 'chat-chip form_disabler';
            chip.setAttribute('data-type', 'id');
            chip.setAttribute('data-file-id', String(fileId));
            chip.title = fileName || '';
            chip.setAttribute('aria-label', fileName || 'Fichier');
            chip.innerHTML = svgFileIcon() + removeBtn();
            return chip;
        }

        function createLocalChip(tmpKey, file) {
            const chip = document.createElement('span');
            chip.className = 'chat-chip';
            chip.setAttribute('data-type', 'local');
            chip.setAttribute('data-tmp-key', tmpKey);
            chip.title = file.name;
            chip.setAttribute('aria-label', file.name);
            chip.innerHTML = svgFileIcon() + removeBtn();
            return chip;
        }

        function ensureHiddenId(hiddenContainer, fileId) {
            if (!hiddenContainer) return;
            const sel = 'input[type="hidden"][name="file_ids[]"][value="' + CSS.escape(String(fileId)) + '"]';
            if (hiddenContainer.querySelector(sel)) return;
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'file_ids[]';
            input.value = String(fileId);
            hiddenContainer.appendChild(input);
        }

        function removeHiddenId(hiddenContainer, fileId) {
            if (!hiddenContainer) return;
            const sel = 'input[type="hidden"][name="file_ids[]"][value="' + CSS.escape(String(fileId)) + '"]';
            const node = hiddenContainer.querySelector(sel);
            if (node) node.remove();
        }

        function removeFromFileInput(fileInput, tmpKeyToRemove) {
            if (!fileInput || !fileInput.files || !fileInput.files.length) return;
            const dt = new DataTransfer();
            for (const file of fileInput.files) {
                const key = makeTmpKey(file);
                if (key !== tmpKeyToRemove) dt.items.add(file);
            }
            fileInput.files = dt.files;
        }

        function makeTmpKey(file) {
            return [file.name, file.size, file.type, file.lastModified].join('|');
        }

        document.addEventListener('click', function (e) {
            const btn = e.target && e.target.closest ? e.target.closest('[data-add-file-id]') : null;
            if (!btn) return;
            const fileId = btn.getAttribute('data-add-file-id');
            const fileName = btn.getAttribute('data-add-file-name') || '';

            for (const mode of Object.keys(containers)) {
                const { chips, hidden } = containers[mode];
                if (!chips) continue;
                if (!chips.querySelector(chipSelectorById(fileId))) {
                    chips.appendChild(createIdChip(fileId, fileName));
                    ensureHiddenId(hidden, fileId);
                }
            }
        });

        for (const mode of Object.keys(containers)) {
            const { chips, fileInput } = containers[mode];
            if (!fileInput || !chips) continue;

            fileInput.addEventListener('change', function () {
                if (!fileInput.files || !fileInput.files.length) return;
                for (const file of fileInput.files) {
                    const tmpKey = makeTmpKey(file);
                    if (chips.querySelector('.chat-chip[data-type="local"][data-tmp-key="' + CSS.escape(tmpKey) + '"]')) continue;
                    chips.appendChild(createLocalChip(tmpKey, file));
                }
            });
        }

        const messageInput = document.querySelector('.chat-input__field');
        if (messageInput) {
            autoResizeComposer(messageInput);
            updateComposerToggleState(messageInput);
            messageInput.addEventListener('input', function () {
                autoResizeComposer(messageInput);
                updateComposerToggleState(messageInput);
            });
            messageInput.addEventListener('keydown', function (event) {
                if (event.key !== 'Enter' || event.shiftKey) return;
                event.preventDefault();
                const form = messageInput.closest('form');
                if (!form || !messageInput.value.trim()) return;
                if (typeof form.requestSubmit === 'function') {
                    form.requestSubmit();
                } else {
                    form.submit();
                }
            });
        }

        function removeChatChip(e) {
            const rem = e && e.closest ? e.closest('.chat-chip__remove') : null;
            if (!rem) return;
            const chip = rem.closest('.chat-chip');
            if (!chip) return;

            const type = chip.getAttribute('data-type');
            if (type === 'id') {
                const fid = chip.getAttribute('data-file-id');
                removeHiddenId(containers.chat.hidden, fid);
                removeHiddenId(containers.stream.hidden, fid);
                for (const mode of Object.keys(containers)) {
                    const list = containers[mode].chips;
                    if (!list) continue;
                    const dup = list.querySelector(chipSelectorById(fid));
                    if (dup) dup.remove();
                }
            } else if (type === 'local') {
                const tmpKey = chip.getAttribute('data-tmp-key');
                removeFromFileInput(containers.chat.fileInput, tmpKey);
                removeFromFileInput(containers.stream.fileInput, tmpKey);
                for (const mode of Object.keys(containers)) {
                    const list = containers[mode].chips;
                    if (!list) continue;
                    list.querySelectorAll('.chat-chip[data-type="local"][data-tmp-key="' + CSS.escape(tmpKey) + '"]').forEach(node => node.remove());
                }
            }
        }

        document.addEventListener('click', function (e) {
            removeChatChip(e.target);
        });
    })();

    // Gestion de l'ascenseur
    (function () {
        const chatBody = document.querySelector('.chat-body');
        const messages = document.getElementById('messages');
        const scrollBtn = document.getElementById('scrollDownBtn');
        if (!chatBody || !scrollBtn) return;

        const threshold = 24;

        function atBottomOf(el) {
            return el.scrollTop + el.clientHeight >= el.scrollHeight - threshold;
        }

        function updateButtonVisibility() {
            if (chatBody.scrollHeight <= chatBody.clientHeight + 1) {
                scrollBtn.style.display = 'none';
                return;
            }
            const atBottom = atBottomOf(chatBody);
            scrollBtn.style.display = atBottom ? 'none' : 'inline-flex';
            if (!atBottom) {
                scrollBtn.style.alignItems = 'center';
                scrollBtn.style.justifyContent = 'center';
            }
        }

        chatBody.addEventListener('scroll', updateButtonVisibility, {passive: true});
        window.addEventListener('resize', updateButtonVisibility);

        scrollBtn.addEventListener('click', function () {
            chatBody.scrollTo({top: chatBody.scrollHeight, behavior: 'smooth'});
        });

        window.addEventListener('DOMContentLoaded', function () {
            updateButtonVisibility();
        });

        document.body.addEventListener('htmx:afterSwap', function (evt) {
            const detail = evt.detail || {};
            const target = detail.target;
            if (target && (target.id === 'messages' || (target.closest && target.closest('#messages')))) {
                updateButtonVisibility();
            }
        });

        if (window.MutationObserver && messages) {
            const mo = new MutationObserver(function () {
                updateButtonVisibility();
            });
            mo.observe(messages, {childList: true, subtree: false});
        }

        updateButtonVisibility();
    })();
</script>
{% endblock %}
