{% extends 'layout.twig' %}

{% block app %}
<section class="claire-chat-panel">
    <div class="claire-chat-shell">
        <header class="claire-chat-header">
            <div class="claire-chat-header__main">
                <img class="claire-chat-header__avatar" src="{{ brain_info.avatar }}">
                <div class="claire-chat-header__info">
                    <span class="claire-chat-header__title">{{ brain_info.name }}</span>
                    <span class="claire-chat-header__subtitle">{{ brain_info.description }}</span>
                </div>
            </div>
            <button
                    class="claire-options-toggle"
                    type="button"
                    aria-label="Ouvrir le menu"
                    aria-expanded="false"
                    hx-on:click="
                        this.classList.toggle('claire-is-active');
                        const expanded = this.classList.contains('claire-is-active');
                        this.setAttribute('aria-expanded', expanded);
                        const panel = document.getElementById('claire-options-panel');
                        if (panel) { panel.classList.toggle('claire-is-open'); }
                        const bd = document.getElementById('claire-options-backdrop');
                        if (bd) { bd.classList.toggle('claire-is-visible', expanded); }
                        // Rafraîchir le compteur d'historiques à l'ouverture du menu
                        if (expanded) {
                            const historyCountUrl = '{{ base_url }}/history/count';
                            const filesCountUrl = '{{ base_url }}/files/count';
                            if (window.htmx) {
                                htmx.ajax('GET', historyCountUrl, {target: '#claire-history-count-badge', swap: 'innerHTML'});
                                htmx.ajax('GET', filesCountUrl, {target: '#claire-files-count-badge', swap: 'innerHTML'});
                            }
                        }
                    "
                >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>
        </header>

        {% include 'partials/chat_body.twig' %}
    </div>
</section>
{% endblock %}

{% block script %}
{% endblock %}
