{
  "name": "semhoun/claire-chatbot",
  "description": "Simple AI Agent Chat in PHP.",
  "license": "MIT",
  "type": "project",
  "keywords": [
    "slim-framework",
    "agentic",
    "doctrine",
    "neuron-ai"
  ],
  "authors": [
    {
      "name": "Nathanaël SEMHOUN",
      "email": "nathanael@semhoun.net",
      "homepage": "https://www.semhoun.net"
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Migrations\\": "migrations/"
    }
  },
  "require": {
    "php": "^8.5",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-dom": "*",
    "ext-pdo": "*",
    "slim/slim": "^4.15",
    "slim/psr7": "^1.8",
    "doctrine/orm": "^3.5",
    "doctrine/dbal": "^4.4",
    "doctrine/migrations": "^3.9",
    "symfony/cache": "^8.0",
    "php-di/slim-bridge": "^3.4",
    "monolog/monolog": "^3.9",
    "symfony/console": "^8.0",
    "slim/twig-view": "^3.4",
    "akrabat/proxy-detection-middleware": "^1.1",
    "guzzlehttp/guzzle": "^7.10",
    "neuron-core/neuron-ai": "3.x",
    "open-telemetry/sdk": "^1.10",
    "open-telemetry/exporter-otlp": "^1.3",
    "open-telemetry/opentelemetry-auto-slim": "^1.3",
    "open-telemetry/opentelemetry-auto-psr18": "^1.1",
    "open-telemetry/opentelemetry-auto-session": "^0.2",
    "open-telemetry/opentelemetry-auto-doctrine": "^0.4",
    "open-telemetry/opentelemetry-auto-curl": "^0.2",
    "open-telemetry/opentelemetry-auto-guzzle": "^1.2",
    "open-telemetry/opentelemetry-logger-monolog": "^1.1",
    "league/commonmark": "^2.8",
    "league/html-to-markdown": "^5.1",
    "league/oauth2-client": "^2.9",
    "league/flysystem": "^3.0",
    "iamgerwin/php-pdf-to-markdown-parser": "^0.0.1",
    "phptg/bot-api": "^0.19",
    "lcobucci/jwt": "^5.5",
    "ramsey/uuid": "^4.9",
    "symfony/yaml": "^8.0",
    "lcobucci/clock": "^3.6",
    "mpdf/mpdf": "^8.3",
    "tempest/highlight": "^2.24"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "nunomaduro/phpinsights": "^2.14",
    "rector/rector": "^2.2",
    "phpunit/phpunit": "^12.5"
  },
  "scripts": {
    "rector:check": "rector process --dry-run",
    "rector:fix": "rector process",
    "insights:check": "phpinsights --config-path=./phpinsights.php",
    "insights:fix": "phpinsights --config-path=./phpinsights.php -- fix",
    "frontend:check": "npm run build && npm test",
    "pre-commit:line-endings": "find . \\( -name '*.php' -o -name '*.css' -o -name '*.js' -o -name '*.html' -o -name '*.twig' \\) ! -path './vendor/*' ! -path './var/*' -print0 | xargs -0 dos2unix -l -k -q -s",
    "pre-commit:permissions-files": "git ls-files | grep -v '^console$' | grep -v 'docker' | xargs -I {} sh -c 'chmod 664 \"{}\"'",
    "pre-commit:permissions-dirs": "find . -type d ! -path './.git/*' ! -path './vendor/*' ! -path './var/*' -print0 | xargs -0 -I {} sh -c 'git check-ignore -q \"{}\" 2>/dev/null || chmod 775 \"{}\"'",
    "test": "phpunit",
    "pre-commit": [
      "@frontend:check",
      "@pre-commit:line-endings",
      "@pre-commit:permissions-files",
      "@pre-commit:permissions-dirs",
      "@rector:fix",
      "@insights:fix"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": true,
      "tbachert/spi": true,
      "cweagans/composer-patches": true
    }
  }
}
